#include <ESP32Servo.h>

Servo myServo;  // Create servo object
int servoPin = 15;  // GPIO pin for servo signal (you can change this)

void setup() {
  Serial.begin(115200);
  
  // Allow allocation of all timers for servo library
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  
  // Attach servo to pin
  myServo.attach(servoPin, 500, 2400);  // Min and max pulse widths for most servos
  
  // Start at 90 degrees
  myServo.write(90);
  Serial.println("Starting at 90 degrees");
  delay(1000);  // Give servo time to reach initial position
}

void loop() {
  // Sweep from 90 to 180 degrees
  Serial.println("Sweeping to 180 degrees...");
   {
    myServo.write(180);
    delay(15);  // Small delay for smooth movement
  }
  Serial.println("At 180 degrees - pausing 1 second");
  delay(1000);  // Stop for 1 second at 180
  
  // Sweep from 180 to 0 degrees
  Serial.println("Sweeping to 0 degrees...");
  {
    myServo.write(0);
    delay(15);  // Small delay for smooth movement
  }
  Serial.println("At 0 degrees - pausing 1 second");
  delay(1000);  // Stop for 1 second at 0
  
  // Move back to 90 degrees
  Serial.println("Moving back to 90 degrees...");
  {
    myServo.write(90);
    delay(15);  // Small delay for smooth movement
  }
  Serial.println("At 90 degrees - pausing 5 seconds");
  delay(5000);  // Pause for 5 seconds at 90 degrees
  
  Serial.println("Cycle complete, starting again...\n");
}
